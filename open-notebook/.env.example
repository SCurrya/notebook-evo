# Open Notebook Configuration Template
# Copy this to .env and replace all CHANGE_ME values
#
# Generate strong values with:
#   openssl rand -base64 48   # for ENCRYPTION_KEY
#   openssl rand -base64 32   # for OPEN_NOTEBOOK_PASSWORD
#   openssl rand -hex 32      # alternative

# =============================================================================
# REQUIRED
# =============================================================================

# Encryption key for storing API credentials securely in the database
# Minimum 32 characters recommended (base64 of 32 random bytes = 44 chars)
OPEN_NOTEBOOK_ENCRYPTION_KEY=CHANGE_ME_USE_openssl_rand_base64_48

# =============================================================================
# DATABASE (Default values work with docker-compose.yml)
# =============================================================================

SURREAL_URL="ws://127.0.0.1:8000/rpc"
SURREAL_USER=root
SURREAL_PASSWORD=CHANGE_ME_strong_db_password
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# =============================================================================
# OPTIONAL: AI Provider API Keys
# =============================================================================
# Prefer configuring these via the UI (Settings -> API Keys)

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=gsk_...
# SENSENOVA_API_KEY=sk-...
# SENSENOVA_BASE_URL=https://api.sensenova.cn/compatible-mode/v2
# SENSENOVA_EMBEDDING_URL=https://api.sensenova.cn/v1/llm/embeddings
# OPENROUTER_API_KEY=sk-or-v1-...

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

API_URL=http://localhost:5055

# OLLAMA_BASE_URL=http://ollama:11434

# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150

# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=CHANGE_ME

# For more configuration options, see:
# https://github.com/lfnovo/open-notebook/blob/main/docs/5-CONFIGURATION/environment-reference.md

# =============================================================================
# MOBILE APP ACCESS (Capacitor + Tailscale + Cloudflare Tunnel)
# =============================================================================

# API password for mobile app authentication (Bearer token)
# The mobile app sends: Authorization: Bearer <this-value>
# Leave empty to disable auth (not recommended for remote access)
OPEN_NOTEBOOK_PASSWORD=CHANGE_ME_USE_openssl_rand_base64_32

# Mobile app API endpoints (discovered at runtime by the app)
TAILSCALE_DOMAIN=your-pc.tail-xxxx.ts.net
CLOUDFLARE_DOMAIN=

# CORS origins for mobile app access
# Add your Tailscale and Cloudflare Tunnel domains below
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost,https://localhost
